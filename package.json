    "test:ci": "vitest --run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wxt": "^0.20.25",
    "vitest": "^4.1.10",
    "jsdom": "^29.1.1"
