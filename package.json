{
  "name": "snow-bot",
  "description": "Browser automation assistant for form filling, scriptable workflows, and task automation.",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt",
    "dev:win_chrome": "wxt -b win_chrome",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest --run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@11.20.0"
}
